<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView con TextureView (un SurfaceView dentro de páginas que se desplazan se queda en negro)
  y SIN controles nativos: la barra de progreso y el botón de pausa son propios del visor y solo
  aparecen al tocar la pantalla. El shutter transparente deja ver la miniatura hasta el primer fotograma.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false" />
